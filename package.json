{
  "name": "adam-deck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Adam Deck — a calm, ADHD-friendly morning dashboard for Adam's Parachute Vault. Two project status cards + a Today/This Week/Later todo board. Fully static, deploys to GitHub Pages.",
  "scripts": {
